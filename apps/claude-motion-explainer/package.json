{
  "name": "claude-motion-explainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 5173",
    "dev:api": "node --disable-warning=ExperimentalWarning --experimental-strip-types server/index.ts",
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test shared/parse.test.ts shared/build-spec.test.ts server/explain.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@remotion/player": "^4.0.535",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.535",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
