# xAI Grok Voice Agent API — the brain. Required.
# Rotate this key in the xAI console if it leaks. Never commit the real value.
XAI_API_KEY=

# Grok realtime voice. Prefer eve; ara is the fallback if this is empty or unknown.
XAI_VOICE=eve

# Optional Grok Voice Agent model override.
# Default in the LiveKit plugin: grok-voice-think-fast-1.0
# XAI_REALTIME_MODEL=grok-voice-think-fast-1.0

# Anam — face / lip-sync only. Not an LLM. Required for video in `dev` mode.
ANAM_API_KEY=

# Cara-3 stock avatar. Override if you swap faces in lab.anam.ai.
ANAM_AVATAR_ID=35069738-6eb1-4eaf-8b56-43d21b67e78d
ANAM_AVATAR_NAME=Vesper

# Optional Anam model pin (leave unset to use the avatar's default, typically Cara-3).
# ANAM_AVATAR_MODEL=cara-3

# LiveKit Cloud (or self-hosted) — transport only. Required for `dev` and the HTML client.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Room the HTML token server mints into. Keep one worker listening as agent name `vesper`.
LIVEKIT_ROOM=vesper-room
VESPER_AGENT_NAME=vesper
