# Optional overrides. The demo needs no secrets.
# Copy to .env in this folder only if you want to change them.
# The Vite app does not read these; only the local API process does.

# Hosted Inspo MCP (Streamable HTTP, no auth). Default is the public endpoint.
INSPO_MCP_URL=https://inspomcp.dev/api/mcp

# When true, get_design_system asks Inspo to fetch the source site (slower).
# Default false uses the captured DESIGN.md already in the archive.
INSPO_DESIGN_LIVE=false
