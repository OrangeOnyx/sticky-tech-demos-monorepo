# Server-side only. Leave ATLAS_STUDIO_API_KEY empty to stay in Sample mode.
# Atlas AI Studio (docs.atlas.design), NOT Orange Ocean Atlas / OTB.
# Copy to .env in this folder. Never commit real values. No VITE_ prefix.
# The exported workflow JSON embeds auth. Gitignore it.
ATLAS_STUDIO_API_KEY=
# From the "Export API" output of your image -> rigged GLB workflow:
ATLAS_STUDIO_BASE_URL=
ATLAS_STUDIO_API_VERSION=
ATLAS_STUDIO_API_ID=
# Header used by the generated Bash/Python example (default shown)
ATLAS_STUDIO_AUTH_HEADER=Authorization
ATLAS_STUDIO_AUTH_SCHEME=Bearer
# Name of the API Input Image parameter in the exported spec
ATLAS_STUDIO_IMAGE_INPUT_KEY=image
# Multipart part name on POST {base}/{version}/upload/{apiId}.
# The public Atlas workflow client sends "file". Override if the Bash example differs.
ATLAS_STUDIO_UPLOAD_FIELD=file
# Download route copied from the Export API example. Required for Live.
# Docs do not publish this path. Placeholders:
#   {base} {version} {api_id} {execution_id} {file_id}
# If your Bash example matches the public workflow client, it is one of:
#   {base}/{version}/download_binary_result/{file_id}
#   {base}/{version}/download_binary_result/{api_id}/{file_id}
# Copy the path the example actually calls.
ATLAS_STUDIO_RESULT_PATH=
# Optional. Which result.outputs entry is the GLB. Blank uses the first file id or URL.
ATLAS_STUDIO_OUTPUT_KEY=
# Optional: poll interval / overall timeout
ATLAS_STUDIO_POLL_MS=3000
ATLAS_STUDIO_TIMEOUT_MS=300000
