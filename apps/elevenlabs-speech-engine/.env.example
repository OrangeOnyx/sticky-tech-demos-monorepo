# Required for live ElevenLabs Speech Engine. Leave empty for fixture mode.
ELEVENLABS_API_KEY=

# Speech Engine ID from `bun run speech-engine:create`.
ELEVENLABS_SPEECH_ENGINE_ID=

# Public wss:// URL for the Speech Engine WebSocket, including /ws.
# Example: wss://your-subdomain.ngrok.app/ws
PUBLIC_WS_URL=

# Optional. Unused by the stub LLM; reserved if you swap in a real model later.
OPENAI_API_KEY=
